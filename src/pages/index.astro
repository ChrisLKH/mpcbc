---
import Base from '../layouts/Base.astro';
import Home from '../components/home/Home.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { requestWithMetadata } from '@tinacms/astro/data';
import fileHome from '../content/settings/homepage.json';
import { client } from '../../tina/__generated__/client';

// Same handshake as [...slug].astro: query through Tina so the editor
// knows which document this page shows, but only take its copy if it
// actually came back with a headline — otherwise the page would render
// blank with no error.
let home = fileHome;
try {
  const res = await requestWithMetadata(
    client.queries.homepage({ relativePath: 'homepage.json' }),
    { priority: 'primary' }
  );
  const fromTina = res?.data?.homepage;
  if (fromTina?.hero?.headline) home = fromTina;
} catch {
  // Tina not running — use the file data.
}
---

<Base>
  {/*
    The whole page is one island, so Tina's live preview redraws every
    section as you type — not only the sections list at the bottom.
  */}
  <TinaIsland name="homepage" wrapper={{ tag: 'div' }} primary>
    <Home home={home} />
  </TinaIsland>
</Base>
