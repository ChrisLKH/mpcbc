---
import servicesData from '../data/services.json';

const { services } = servicesData;

// Heading and intro come from the CMS (Homepage -> Service times board).
// `tinaField` markers are passed in rather than computed here: a component
// can't take a bare data-tina-field attribute, so the caller hands down the
// strings and we stamp them onto real elements.
const {
  // The homepage board is the #sunday anchor. A second board dropped onto
  // a page as a block needs its own id, or aria-labelledby resolves to
  // whichever heading came first.
  anchor = 'sunday',
  label = 'This Sunday',
  labelZh = '本主日',
  heading = 'Three congregations, one morning.',
  intro = 'Each congregation streams on its own channel. Live links update automatically from YouTube — nobody edits this weekly.',
  showFooter = true,
  tinaField,
  headingField,
  introField,
} = Astro.props;

/**
 * Editorial copy about each congregation. Deliberately not in
 * services.json — that file is overwritten by the scheduled YouTube sync
 * and nobody edits it by hand, so prose would be lost on the next run.
 */
const COPY = {
  cantonese: {
    channel: '粵語頻道',
    channelLang: 'zh-Hant',
    blurb: 'Our founding congregation. Preaching in Cantonese, tea afterwards in the courtyard.',
  },
  english: {
    channel: 'English channel',
    channelLang: null,
    blurb: 'Mostly the children and grandchildren of the founding families. Sunday school runs at the same hour.',
  },
  mandarin: {
    channel: '國語頻道',
    channelLang: 'zh-Hant',
    blurb: 'Our newest congregation, with traditional-character subtitles. Sunday school at the same hour.',
  },
};

/**
 * Every state has to look deliberate. The board cannot promise which one
 * it will be in on a given Sunday and nobody edits it weekly, so there is
 * no "empty" variant — only a different label and a different first action.
 */
const STATE = {
  live:        { well: 'youtube · live now',       action: 'Watch now' },
  scheduled:   { well: 'youtube · scheduled',      action: 'Set a reminder' },
  unscheduled: { well: 'youtube · last recording', action: 'Go to channel' },
  ended:       { well: 'youtube · last recording', action: 'Watch the recording' },
};

const shortName = (s) => s.name.replace(/\s*Service$/, '');

function href(s) {
  if (
    (s.state === 'live' || s.state === 'scheduled') &&
    s.confidence === 'high' &&
    s.videoId
  ) {
    return `https://youtube.com/watch?v=${s.videoId}`;
  }
  return s.channelUrl;
}
---

<section class="board" id={anchor} aria-labelledby={`${anchor}-heading`} data-tina-field={tinaField}>
  <div class="wrap">
    <div class="board__head">
      <div>
        <p class="rule-label">
          {label} <span class="zh-inline" lang="zh-Hant">{labelZh}</span>
        </p>
        <h2 id={`${anchor}-heading`} class="board__heading" data-tina-field={headingField}>{heading}</h2>
      </div>
      {intro && <p class="board__intro" data-tina-field={introField}>{intro}</p>}
    </div>

    <ul class="board__list" role="list">
      {services.map((s) => {
        const copy = COPY[s.id] || { channel: s.name, channelLang: null, blurb: '' };
        const state = STATE[s.state] || STATE.unscheduled;
        const live = s.state === 'live';

        return (
          <li class:list={['svc', { 'svc--live': live }]} data-svc={s.id}>
            <div class="svc__well">
              <span class="svc__wellLabel" data-svc-well>
                <span class="svc__dot" data-svc-dot aria-hidden="true" hidden={!live}></span>
                {state.well}
              </span>
              <span class="svc__channel" lang={copy.channelLang || undefined}>{copy.channel}</span>
            </div>

            <div>
              <h3
                class:list={['svc__name', { 'svc__name--zh': s.lang !== 'en' }]}
                lang={s.lang !== 'en' ? s.lang : undefined}
              >{s.nameLocal}</h3>
              <p class="svc__meta" data-svc-meta>
                {live ? 'Live now' : shortName(s)} &middot; {s.time}
              </p>
            </div>

            {copy.blurb && <p class="svc__blurb">{copy.blurb}</p>}

            <div class="svc__actions">
              <a
                class:list={['btn', 'btn--sm', { 'btn--ghost': !live }]}
                href={href(s)}
                data-svc-cta
              >{state.action}</a>
              <a
                class:list={['btn', 'btn--sm', 'btn--ghost', { 'btn--ghost-on-tint': live }]}
                href={`/sermons#${s.id}`}
                data-svc-archive
              >Archive <span class="zh-inline" lang="zh-Hant">存檔</span></a>
            </div>
          </li>
        );
      })}
    </ul>

    {showFooter && (
      <div class="board__foot">
        <p class="board__note">
          Watching from home? Open the player for your congregation. Every service
          is posted to the sermon archive within a day or two.
        </p>
        <div class="board__footActions">
          <a class="btn btn--sm btn--ghost" href="/sermons">All sermons</a>
          <a class="btn btn--sm btn--ghost" href="https://youtube.com/@mpcbc-english">Our YouTube channels</a>
        </div>
      </div>
    )}
  </div>
</section>

<script is:inline>
  /**
   * The board above is prerendered, so its state is only as fresh as the last
   * build. /api/services.json runs on demand and reads what the cron Worker
   * put in KV — this swaps the four things that actually change: the card
   * treatment, the well label and its dot, the meta line, and the first CTA.
   *
   * Deliberately silent on failure: the served markup is already a usable
   * board with real times and channel links, so a fetch error degrades to
   * "slightly stale" rather than "broken". Nothing here is required for the
   * page to work, which is why it's plain inline JS and not an island.
   *
   * The state tables are mirrored from the frontmatter above. Two small
   * copies beat shipping a framework runtime to patch three cards.
   */
  (async () => {
    const STATE = {
      live:        { well: 'youtube · live now',       action: 'Watch now' },
      scheduled:   { well: 'youtube · scheduled',      action: 'Set a reminder' },
      unscheduled: { well: 'youtube · last recording', action: 'Go to channel' },
      ended:       { well: 'youtube · last recording', action: 'Watch the recording' },
    };

    const target = (s) =>
      (s.state === 'live' || s.state === 'scheduled') &&
      s.confidence === 'high' &&
      s.videoId
        ? `https://youtube.com/watch?v=${s.videoId}`
        : s.channelUrl;

    try {
      const res = await fetch('/api/services.json');
      if (!res.ok) return;
      const { services } = await res.json();

      for (const s of services || []) {
        const card = document.querySelector(`[data-svc="${s.id}"]`);
        if (!card) continue;

        const state = STATE[s.state] || STATE.unscheduled;
        const live = s.state === 'live';

        card.classList.toggle('svc--live', live);

        const dot = card.querySelector('[data-svc-dot]');
        const well = card.querySelector('[data-svc-well]');
        if (well) {
          // Rewrite only the label text, leaving the dot element in place.
          const text = well.lastChild;
          if (text) text.textContent = state.well;
        }
        if (dot) dot.hidden = !live;

        const meta = card.querySelector('[data-svc-meta]');
        if (meta) {
          const name = live
            ? 'Live now'
            : (s.name || '').replace(/\s*Service$/, '');
          meta.textContent = `${name} · ${s.time}`;
        }

        const cta = card.querySelector('[data-svc-cta]');
        if (cta) {
          cta.textContent = state.action;
          cta.href = target(s);
          cta.className = live
            ? 'btn btn--sm'
            : 'btn btn--sm btn--ghost';
        }

        // The archive button sits on a tinted ground only while the card
        // is the live one, so it has to follow the state too.
        const archive = card.querySelector('[data-svc-archive]');
        if (archive) archive.classList.toggle('btn--ghost-on-tint', live);
      }
    } catch {
      // Offline or endpoint down — keep the prerendered board.
    }
  })();
</script>

<style>
  .board { padding-block: clamp(3rem, 8vw, 6rem); }

  .board__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.2rem;
  }
  .board__heading { margin: 0; }
  .board__intro {
    margin: 0;
    font-family: var(--font-meta);
    font-size: var(--step--2);
    font-weight: 600;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 40ch;
  }

  .board__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .svc {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem 1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .svc--live { border-color: var(--accent); background: var(--tint); }

  .svc__well {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: var(--shell);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    text-align: center;
    padding: 1rem;
  }
  .svc__wellLabel {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .svc--live .svc__wellLabel { color: var(--live-soft); }
  .svc__channel { font-size: var(--step-0); color: var(--white); }

  .svc__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
    display: block;
    animation: svcPulse 1.8s ease-in-out infinite;
  }
  .svc__dot[hidden] { display: none; }

  @keyframes svcPulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }

  .svc__name { margin: 0 0 0.2rem; }
  .svc__name--zh { font-family: var(--font-zh); }

  .svc__meta {
    margin: 0;
    font-family: var(--font-meta);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    max-width: none;
  }
  .svc--live .svc__meta { color: var(--live); }

  .svc__blurb { margin: 0; color: var(--ink-soft); font-size: var(--step--1); }

  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .board__foot {
    margin-top: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2.5rem;
  }
  .board__note { margin: 0; max-width: 52ch; color: var(--ink-soft); font-size: var(--step--1); }
  .board__footActions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
</style>
