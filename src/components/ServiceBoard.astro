---
import servicesData from '../data/services.json';

const { services } = servicesData;

// Heading and intro come from the CMS (Homepage -> Service times board).
// `tinaField` markers are passed in rather than computed here: a component
// can't take a bare data-tina-field attribute, so the caller hands down the
// strings and we stamp them onto real elements.
const {
  heading = 'Join us this Sunday',
  intro = '',
  tinaField,
  headingField,
  introField,
} = Astro.props;

const stateCopy = {
  live:        { label: 'Live now',    action: 'Watch now' },
  scheduled:   { label: 'Starts soon', action: 'Set a reminder' },
  unscheduled: { label: null,          action: 'Go to channel' },
  ended:       { label: null,          action: 'Watch the recording' },
};

function href(s) {
  if (s.state === 'live' || s.state === 'scheduled') {
    if (s.confidence === 'high' && s.videoId) return `https://youtube.com/watch?v=${s.videoId}`;
    return s.channelUrl;
  }
  return s.channelUrl;
}
---

<section class="board" aria-labelledby="board-heading" data-tina-field={tinaField}>
  <div class="wrap">
    <h2 id="board-heading" class="board__heading" data-tina-field={headingField}>{heading}</h2>
    {intro && <p class="board__intro" data-tina-field={introField}>{intro}</p>}

    <ul class="board__list" role="list">
      {services.map((s) => (
        <li class={`svc svc--${s.state}`} data-svc={s.id}>
          <div class="svc__top">
            <p class="svc__local" lang={s.lang}>{s.nameLocal}</p>
            {s.lang !== 'en' && <p class="svc__en">{s.name}</p>}
            <span class="svc__live" data-svc-live hidden={s.state !== 'live'}>
              <span class="svc__dot" aria-hidden="true"></span>Live now
            </span>
          </div>

          <p class="svc__time">
            <span class="svc__day">{s.day}</span>
            <span class="svc__clock">{s.time}</span>
          </p>

          <a
            class={`svc__cta ${s.state === 'live' ? 'btn' : 'btn btn--ghost'}`}
            href={href(s)}
            data-svc-cta
          >
            {stateCopy[s.state].action}
          </a>
        </li>
      ))}
    </ul>

    <p class="board__auto">
      Live links update automatically from YouTube. Nobody edits this weekly.
    </p>
  </div>
</section>

<script is:inline>
  /**
   * The board above is prerendered, so its state is only as fresh as the last
   * build. /api/services.json runs on demand and reads what the cron Worker
   * put in KV — this swaps the three things that actually change.
   *
   * Deliberately silent on failure: the served markup is already a usable
   * board with real times and channel links, so a fetch error degrades to
   * "slightly stale" rather than "broken". Nothing here is required for the
   * page to work, which is why it's plain inline JS and not an island.
   *
   * The state->label and state->href rules are mirrored from the frontmatter
   * above. Two small copies beat shipping a framework runtime to patch
   * three anchors.
   */
  (async () => {
    const ACTION = {
      live: 'Watch now',
      scheduled: 'Set a reminder',
      unscheduled: 'Go to channel',
      ended: 'Watch the recording',
    };

    const target = (s) =>
      (s.state === 'live' || s.state === 'scheduled') &&
      s.confidence === 'high' &&
      s.videoId
        ? `https://youtube.com/watch?v=${s.videoId}`
        : s.channelUrl;

    try {
      const res = await fetch('/api/services.json');
      if (!res.ok) return;
      const { services } = await res.json();

      for (const s of services || []) {
        const card = document.querySelector(`[data-svc="${s.id}"]`);
        if (!card) continue;

        card.className = `svc svc--${s.state}`;

        const badge = card.querySelector('[data-svc-live]');
        if (badge) badge.hidden = s.state !== 'live';

        const cta = card.querySelector('[data-svc-cta]');
        if (cta) {
          cta.textContent = ACTION[s.state] || ACTION.unscheduled;
          cta.href = target(s);
          cta.className =
            s.state === 'live' ? 'svc__cta btn' : 'svc__cta btn btn--ghost';
        }
      }
    } catch {
      // Offline or endpoint down — keep the prerendered board.
    }
  })();
</script>

<style>
  .board {
    background: var(--stucco-dim);
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
    border-block: 1px solid rgba(42, 29, 22, 0.1);
  }

  .board__heading { margin-bottom: 0.25em; }

  .board__intro {
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }

  .board__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: rgba(42, 29, 22, 0.13);
    border: 1px solid rgba(42, 29, 22, 0.13);
    border-radius: var(--radius);
    overflow: hidden;
  }

  @media (min-width: 46rem) {
    .board__list { grid-template-columns: repeat(3, 1fr); }
  }

  .svc {
    background: var(--paper);
    padding: 1.5rem 1.35rem 1.6rem;
    display: flex;
    flex-direction: column;
  }

  .svc--live { background: var(--white); }

  .svc__top { margin-bottom: 1.1rem; }

  .svc__local {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }

  .svc__en {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: 0.15rem 0 0;
    letter-spacing: 0.02em;
  }

  .svc__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--live);
  }

  .svc__dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--live);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
  }

  .svc__time {
    margin: 0 0 1.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .svc__day {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .svc__clock {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .svc__cta {
    margin-top: auto;
    align-self: flex-start;
  }

  .board__auto {
    margin: 1.5rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
    font-style: italic;
    max-width: none;
  }
</style>
