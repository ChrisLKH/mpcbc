---
/**
 * Renders a list of CMS blocks. Used by the homepage and by every page
 * created through the editor, so a section built once is available
 * everywhere.
 */
import ServiceBoard from './ServiceBoard.astro';
import AnnouncementCarousel from './home/AnnouncementCarousel.astro';
import PastorNote from './home/PastorNote.astro';
import Children from './home/Children.astro';
import UpcomingEvents from './home/UpcomingEvents.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { getCollection } from 'astro:content';

const { sections = [] } = Astro.props;

/**
 * Click-to-edit marker. Tina stamps every object it returns with
 * `_content_source`; tinaField() reads that to name the field. Keystatic
 * data has no stamp, so this returns '' — mapped to undefined so the
 * attribute is omitted entirely rather than rendering empty.
 */
const field = (obj, prop) => tinaField(obj, prop) || undefined;

/**
 * The same block reaches this component in three different shapes:
 *
 *   Keystatic file   { discriminant: 'textBlock', value: { heading, body } }
 *   Tina file        { heading, body, _template: 'textBlock' }
 *   Tina GraphQL     { heading, body, __typename: 'PagesSectionsTextBlock' }
 *
 * Normalise all three to the Keystatic shape so one renderer serves
 * every source. Without this the data matches nothing and the page
 * renders empty with no error — which is exactly what it looks like.
 *
 * The Tina *file* case matters now that pages are loaded from the Tina
 * tree: that is what a prerendered page falls back to whenever the Tina
 * server isn't running, which includes every production build.
 */
const BLOCK_NAMES = [
  'textBlock', 'imageText', 'gallery', 'videoEmbed', 'buttons',
  'serviceBoard', 'announcements', 'recentSermons', 'facebookAlbum', 'flexible',
  // The homepage's designed sections (homeBlocks in tina/config.ts). They
  // are blocks rather than fixed groups so editors can reorder or remove
  // them like any other section.
  'serviceTimes', 'announcementsSection', 'pastorNote', 'children', 'upcomingEvents',
];

// The component library that can appear INSIDE a 'flexible' section —
// see flexibleItems in tina/config.ts. Same three shapes, a different
// name list, so it needs its own pass through the same logic below.
const ITEM_NAMES = ['heading', 'paragraph', 'image', 'button', 'video'];

function normaliseAgainst(block, names) {
  if (!block) return null;
  if (block.discriminant) return block;

  // Tina file data names the template exactly.
  const template = String(block._template || '');
  if (names.includes(template)) {
    return { discriminant: template, value: block };
  }

  // Tina GraphQL data prefixes it, e.g. PagesSectionsTextBlock.
  const typename = String(block.__typename || '');
  const match = names.find((name) =>
    typename.toLowerCase().endsWith(name.toLowerCase())
  );
  return match ? { discriminant: match, value: block } : null;
}

const normalise = (block) => normaliseAgainst(block, BLOCK_NAMES);
const normaliseItem = (item) => normaliseAgainst(item, ITEM_NAMES);

const blocks = (sections || []).map(normalise).filter(Boolean);

/**
 * Pulls an 11-character YouTube video ID out of a watch/share/embed URL,
 * or passes a bare ID straight through. The flexible section's video
 * component stores whatever an editor pastes; the videoEmbed section
 * stores a bare ID already, so both need to work.
 */
function youtubeId(input) {
  const value = String(input || '').trim();
  if (!value) return '';
  if (/^[\w-]{11}$/.test(value)) return value;
  const match = value.match(
    /(?:youtu\.be\/|youtube(?:-nocookie)?\.com\/(?:watch\?v=|embed\/|live\/))([\w-]{11})/
  );
  return match ? match[1] : '';
}

const today = new Date();

const announcements = (await getCollection('announcements'))
  .filter((a) => a.data.removeAfter >= today)
  .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned));

const allSermons = (await getCollection('sermons'))
  .filter((s) => !s.data.hide)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const label = { english: 'English', cantonese: '粵語', mandarin: '國語', all: 'All' };

// The designed homepage sections date their lists from midnight, so an
// announcement or event dated today still shows all day.
const startOfToday = new Date();
startOfToday.setHours(0, 0, 0, 0);

const currentAnnouncements = announcements.filter((a) => a.data.removeAfter >= startOfToday);

const upcomingEvents = (await getCollection('events'))
  .filter((e) => e.data.startDate >= startOfToday)
  .sort((a, b) => a.data.startDate - b.data.startDate);

/**
 * The designed sections keep their own default wording, so a field left
 * blank falls back to it instead of rendering empty. Tina's GraphQL answers
 * `null` for an empty field, and `null` does not trigger a default, so
 * those are stripped first — along with `_template` and Tina's own keys.
 */
const props = (obj) =>
  Object.fromEntries(
    Object.entries(obj || {}).filter(
      ([k, v]) => v !== null && v !== undefined && !k.startsWith('_')
    )
  );
---

{blocks.map((block, i) => {
  const v = block.value;

  if (block.discriminant === 'serviceTimes') {
    return (
      <ServiceBoard
        {...props(v)}
        blurbs={props({
          english: v.englishBlurb,
          cantonese: v.cantoneseBlurb,
          mandarin: v.mandarinBlurb,
        })}
        tinaField={field(v)}
        headingField={field(v, 'heading')}
        introField={field(v, 'intro')}
      />
    );
  }

  if (block.discriminant === 'announcementsSection') {
    return (
      <AnnouncementCarousel
        {...props(v)}
        announcements={currentAnnouncements}
        tinaField={field(v)}
      />
    );
  }

  if (block.discriminant === 'pastorNote') {
    return <PastorNote {...props(v)} tinaField={field(v)} />;
  }

  if (block.discriminant === 'children') {
    return <Children {...props(v)} tinaField={field(v)} />;
  }

  if (block.discriminant === 'upcomingEvents') {
    return <UpcomingEvents {...props(v)} events={upcomingEvents} tinaField={field(v)} />;
  }

  if (block.discriminant === 'serviceBoard') {
    return (
      <ServiceBoard
        anchor={`services-${i}`}
        heading={v.heading}
        intro={v.intro}
        tinaField={field(v)}
        headingField={field(v, 'heading')}
        introField={field(v, 'intro')}
      />
    );
  }

  if (block.discriminant === 'announcements') {
    const items = announcements.slice(0, v.limit);
    if (!items.length) return null;
    return (
      <section class="section" data-tina-field={field(v)}>
        <div class="wrap">
          <h2 data-tina-field={field(v, 'heading')}>{v.heading}</h2>
          <ul class="cards" role="list">
            {items.map((a) => (
              <li class="card">
                <p class="eyebrow">{label[a.data.congregation]}</p>
                <h3>{a.data.title}</h3>
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
  }

  if (block.discriminant === 'recentSermons') {
    const items = allSermons.slice(0, v.limit);
    return (
      <section class="section section--tint" data-tina-field={field(v)}>
        <div class="wrap">
          <div class="head">
            <h2 data-tina-field={field(v, 'heading')}>{v.heading}</h2>
            <a href="/sermons">All sermons</a>
          </div>
          <ul class="cards" role="list">
            {items.map((s) => (
              <li class="card">
                <p class="eyebrow">{label[s.data.congregation]} &middot; {s.data.date}</p>
                <h3>{s.data.title}</h3>
                {(s.data.speaker || s.data.scripture) && (
                  <p class="card__meta">
                    {[s.data.speaker, s.data.scripture].filter(Boolean).join(' · ')}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
  }

  if (block.discriminant === 'gallery') {
    const photos = v.photos || [];
    if (!photos.length) return null;
    return (
      <section class="section" data-tina-field={field(v)}>
        <div class="wrap">
          {v.heading && <h2 data-tina-field={field(v, 'heading')}>{v.heading}</h2>}
          <ul class={`gal gal--${v.layout}`} role="list" data-tina-field={field(v, 'photos')}>
            {photos.map((p) => (
              <li class="gal__item" data-tina-field={field(p)}>
                <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />
                {p.caption && <p class="gal__cap" data-tina-field={field(p, 'caption')}>{p.caption}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
  }

  if (block.discriminant === 'videoEmbed') {
    return (
      <section class="section section--tint" data-tina-field={field(v)}>
        <div class="wrap wrap--narrow">
          {v.heading && <h2 data-tina-field={field(v, 'heading')}>{v.heading}</h2>}
          <div class="embed" data-tina-field={field(v, 'youtubeId')}>
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}`}
              title={v.heading || 'Video'}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          {v.caption && <p class="embed__cap" data-tina-field={field(v, 'caption')}>{v.caption}</p>}
        </div>
      </section>
    );
  }

  if (block.discriminant === 'facebookAlbum') {
    return (
      <section class="section" data-tina-field={field(v)}>
        <div class="wrap wrap--narrow">
          {v.heading && <h2 data-tina-field={field(v, 'heading')}>{v.heading}</h2>}
          {v.body && <p data-tina-field={field(v, 'body')}>{v.body}</p>}
          {v.url && (
            <p>
              <a class="btn btn--ghost" href={v.url} data-tina-field={field(v, 'linkText')}>
                {v.linkText}
              </a>
            </p>
          )}
        </div>
      </section>
    );
  }

  if (block.discriminant === 'textBlock') {
    return (
      <section class={`section ${v.tinted ? 'section--tint' : ''}`} data-tina-field={field(v)}>
        <div class="wrap wrap--narrow">
          {v.heading && <h2 data-tina-field={field(v, 'heading')}>{v.heading}</h2>}
          <p data-tina-field={field(v, 'body')}>{v.body}</p>
        </div>
      </section>
    );
  }

  if (block.discriminant === 'imageText') {
    return (
      <section class="section" data-tina-field={field(v)}>
        <div class={`wrap split ${v.imageSide === 'right' ? 'split--flip' : ''}`}>
          {v.image && (
            <img class="split__img" src={v.image} alt={v.alt || ''} data-tina-field={field(v, 'image')} />
          )}
          <div>
            {v.heading && <h2 data-tina-field={field(v, 'heading')}>{v.heading}</h2>}
            <p data-tina-field={field(v, 'body')}>{v.body}</p>
            {v.ctaText && (
              <p class="btnrow">
                <a class="btn" href={v.ctaLink || '#'} data-tina-field={field(v, 'ctaText')}>
                  {v.ctaText}
                </a>
              </p>
            )}
          </div>
        </div>
      </section>
    );
  }

  if (block.discriminant === 'buttons') {
    const links = v.links || [];
    if (!links.length) return null;
    return (
      <section class="section" data-tina-field={field(v)}>
        <div class="wrap wrap--narrow">
          {v.heading && <h2 data-tina-field={field(v, 'heading')}>{v.heading}</h2>}
          <p class="btnrow" data-tina-field={field(v, 'links')}>
            {links.map((l, i) => (
              <a
                class={`btn ${i > 0 ? 'btn--ghost' : ''}`}
                href={l.url}
                data-tina-field={field(l)}
              >{l.text}</a>
            ))}
          </p>
        </div>
      </section>
    );
  }

  if (block.discriminant === 'flexible') {
    const items = (v.items || []).map(normaliseItem).filter(Boolean);
    if (!items.length) return null;
    return (
      <section class="section" data-tina-field={field(v)}>
        <div class="wrap">
          <div class="flexstack" data-tina-field={field(v, 'items')}>
            {items.map((item) => {
              const iv = item.value;

              /**
               * Each piece renders its own content, then gets one common
               * wrapper below. The wrapper is what carries the width and
               * the item-level edit marker, so every piece is a grid item
               * of the same kind however it is built — a button row and an
               * image line up because they are the same box, not because
               * their own markup was made to match.
               */
              let inner = null;

              if (item.discriminant === 'heading' && iv.text) {
                inner = <h2 data-tina-field={field(iv, 'text')}>{iv.text}</h2>;
              }

              if (item.discriminant === 'paragraph' && iv.text) {
                inner = <p data-tina-field={field(iv, 'text')}>{iv.text}</p>;
              }

              if (item.discriminant === 'image' && iv.src) {
                inner = (
                  <img
                    data-tina-field={field(iv, 'src')}
                    src={iv.src}
                    alt={iv.alt || ''}
                    loading="lazy"
                    decoding="async"
                  />
                );
              }

              if (item.discriminant === 'button' && iv.text) {
                inner = (
                  <p class="btnrow">
                    <a class="btn" href={iv.url || '#'} data-tina-field={field(iv, 'text')}>
                      {iv.text}
                    </a>
                  </p>
                );
              }

              if (item.discriminant === 'video') {
                const id = youtubeId(iv.url);
                if (id) {
                  inner = (
                    <div class="embed" data-tina-field={field(iv, 'url')}>
                      <iframe
                        src={`https://www.youtube-nocookie.com/embed/${id}`}
                        title="Video"
                        loading="lazy"
                        allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
                        allowfullscreen
                      ></iframe>
                    </div>
                  );
                }
              }

              if (!inner) return null;
              return (
                <div
                  class={iv.width === 'half' ? 'flexstack__half' : undefined}
                  data-tina-field={field(iv)}
                >{inner}</div>
              );
            })}
          </div>
        </div>
      </section>
    );
  }

  return null;
})}

<style is:global>
  .section--tint { background: var(--tint); }

  .head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }
  .head h2 { margin-bottom: 0.6em; }
  .head a { font-size: var(--step--1); }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  @media (min-width: 44rem) { .cards { grid-template-columns: repeat(3, 1fr); } }

  /* Bordered and rounded, matching the service board and the panels on
     the homepage, rather than the accent top-rule the old palette used. */
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.15rem 1.3rem;
  }
  .card h3 { margin-bottom: 0.25em; }
  .card .eyebrow { color: var(--accent); }
  .card__meta { font-size: var(--step--1); color: var(--ink-soft); margin: 0; }

  .split { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 44rem) {
    .split { grid-template-columns: 1fr 1fr; }
    .split--flip .split__img { order: 2; }
  }
  .split__img { border-radius: var(--radius); }

  .gal { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .gal--grid { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .gal--strip {
    grid-auto-flow: column; grid-auto-columns: minmax(220px, 1fr);
    overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 0.5rem;
  }
  .gal--strip .gal__item { scroll-snap-align: start; }
  .gal__item img {
    width: 100%; aspect-ratio: 4/3; object-fit: cover;
    border-radius: var(--radius); background: var(--tint);
  }
  .gal__cap { font-size: var(--step--1); color: var(--ink-soft); margin: 0.4rem 0 0; }

  .embed {
    position: relative; aspect-ratio: 16/9;
    border-radius: var(--radius); overflow: hidden; background: var(--shell);
  }
  .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .embed__cap { font-size: var(--step--1); color: var(--ink-soft); margin-top: 0.75rem; }

  .btnrow { display: flex; flex-wrap: wrap; gap: 0.75rem; max-width: none; }

  /* Flexible section: a generic stack that has to look right whatever
     components an editor puts in it and in whatever order, so it only
     sets spacing and never assumes what comes next. */
  .flexstack { display: grid; gap: 1.25rem; }
  /* Headings and paragraphs carry their own bottom margin from
     global.css. Left alone it stacks on top of the grid gap, so the
     spacing would depend on which components happen to sit next to
     each other. The grid owns the rhythm; the components contribute
     none. */
  .flexstack > * { margin-block: 0; }
  .flexstack > * > :last-child { margin-bottom: 0; }
  .flexstack img {
    max-width: 100%; height: auto; border-radius: var(--radius);
    background: var(--tint);
  }
  /* Two columns, with every piece spanning both unless it says otherwise.
     That is what lets one section mix the two: a heading and a paragraph
     across the top, then two half-width pieces side by side under them.
     An odd half-width piece simply leaves the other column empty, which
     is the sane reading of what the editor asked for. Below the
     breakpoint the grid is a single column and every piece stacks, so
     `half` needs no separate mobile handling. */
  @media (min-width: 44rem) {
    .flexstack { grid-template-columns: 1fr 1fr; column-gap: 2rem; align-items: start; }
    .flexstack > * { grid-column: 1 / -1; }
    .flexstack > .flexstack__half { grid-column: span 1; }
  }
</style>
