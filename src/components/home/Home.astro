---
/**
 * The whole homepage, from one homepage document.
 *
 * Rendered in three places, which is why it is one component:
 *
 *   src/pages/index.astro             the live site
 *   src/pages/tina-island/[name].ts   Tina's live preview while typing
 *   src/pages/cms-preview/[kind].astro  the Decap / Sveltia preview
 *
 * The hero is pinned to the top: it carries the page's only <h1> and is
 * designed as a full-bleed opener, so it is a fixed group of fields.
 * Everything under it — including the designed sections (service times,
 * announcements, pastor's note, children, coming up) — is the `sections`
 * list, which Blocks.astro renders in whatever order the editor chose.
 *
 * Every word comes from src/content/settings/homepage.json. Each component
 * keeps its own defaults, so a field left out of the file falls back to
 * them rather than rendering blank. Tina's GraphQL answers `null` for an
 * empty field, and `null` does not trigger a default, so props() strips
 * those first.
 */
import Blocks from '../Blocks.astro';
import Hero from './Hero.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import servicesData from '../../data/services.json';

const { home = {} } = Astro.props;

const props = (obj) =>
  Object.fromEntries(
    Object.entries(obj || {}).filter(
      ([k, v]) => v !== null && v !== undefined && !k.startsWith('_')
    )
  );

// Click-to-edit marker; empty outside Tina, so the attribute is omitted.
const field = (obj, prop) => (obj ? tinaField(obj, prop) : '') || undefined;

const hero = home.hero || {};
---

<Hero
  {...props(hero)}
  services={servicesData.services}
  tinaField={field(home.hero)}
  headlineField={field(home.hero, 'headline')}
  headlineZhField={field(home.hero, 'headlineZh')}
  ledeField={field(home.hero, 'lede')}
/>

<Blocks sections={home.sections || []} />
