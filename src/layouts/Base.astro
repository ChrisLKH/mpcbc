---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const {
  title = 'Monterey Park Chinese Baptist Church',
  description = 'A Chinese Baptist church in Monterey Park with Cantonese, Mandarin, and English services every Sunday. Everyone is welcome.',
  lang = 'en',
} = Astro.props;

// Pages created in the editor appear here automatically when
// "Show in the menu" is ticked. No code change needed.
const cmsPages = (await getCollection('pages'))
  .filter((p) => p.data.showInMenu)
  .map((p) => ({
    href: `/${p.id}`,
    label: p.id.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
  }));

const nav = [
  { href: '/visit', label: 'Plan your visit' },
  ...cmsPages,
  { href: '/sermons', label: 'Sermons' },
  { href: '/events', label: 'Events' },
  { href: '/english', label: 'English' },
  { href: '/cantonese', label: '粵語' },
  { href: '/mandarin', label: '國語' },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&family=Noto+Sans+TC:wght@400;600&family=Noto+Serif+TC:wght@600&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data: lets Google show service times directly in results. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Church',
      name: 'Monterey Park Chinese Baptist Church',
      alternateName: '蒙特利公園華人浸信會',
      url: 'https://mpcbc.org',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Monterey Park',
        addressRegion: 'CA',
        addressCountry: 'US',
      },
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:30', closes: '10:45', name: 'Cantonese Service' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '11:00', closes: '12:15', name: 'English Service' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '11:30', closes: '12:45', name: 'Mandarin Service' },
      ],
    })} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap masthead__inner">
        <a class="brand" href="/">
          <span class="brand__zh" lang="zh-Hant">蒙特利公園華人浸信會</span>
          <span class="brand__en">Monterey Park Chinese Baptist Church</span>
        </a>
        <nav aria-label="Main">
          <ul role="list" class="nav">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__inner">
        <div>
          <p class="foot__name" lang="zh-Hant">蒙特利公園華人浸信會</p>
          <p class="foot__name">Monterey Park Chinese Baptist Church</p>
          <p class="foot__meta">Serving the San Gabriel Valley since 1976</p>
        </div>
        <div>
          <p class="eyebrow">Sundays</p>
          <p class="foot__meta">9:30 AM &middot; Cantonese 粵語</p>
          <p class="foot__meta">11:00 AM &middot; English</p>
          <p class="foot__meta">11:30 AM &middot; Mandarin 國語</p>
        </div>
      </div>
    </footer>

    <style>
      .masthead {
        border-bottom: 1px solid rgba(42, 29, 22, 0.12);
        background: var(--paper);
      }
      .masthead__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.9rem 1.5rem;
        padding-block: 1.1rem;
      }
      .brand { text-decoration: none; color: var(--ink); display: block; }
      .brand__zh {
        display: block;
        font-family: var(--font-display);
        font-size: var(--step-1);
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: 0.02em;
      }
      .brand__en {
        display: block;
        font-size: var(--step--1);
        color: var(--ink-soft);
        letter-spacing: 0.04em;
        margin-top: 0.15rem;
      }
      .nav {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.15rem;
        margin: 0;
        padding: 0;
        font-size: var(--step--1);
      }
      .nav a {
        color: var(--ink-soft);
        text-decoration: none;
        padding-block: 0.2rem;
        border-bottom: 2px solid transparent;
      }
      .nav a:hover { color: var(--ink); border-bottom-color: var(--stucco); }
      .nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--sky); }

      .foot {
        background: var(--ink);
        color: var(--stucco);
        padding-block: clamp(2.5rem, 6vw, 4rem);
        margin-top: 2rem;
      }
      .foot__inner {
        display: grid;
        gap: 2rem;
      }
      @media (min-width: 40rem) {
        .foot__inner { grid-template-columns: 1fr auto; }
      }
      .foot__name {
        font-family: var(--font-display);
        font-size: var(--step-1);
        margin: 0;
        color: var(--paper);
      }
      .foot__meta {
        margin: 0.2rem 0 0;
        font-size: var(--step--1);
        color: rgba(229, 217, 197, 0.75);
      }
      .foot .eyebrow { color: rgba(229, 217, 197, 0.6); }
    </style>
  </body>
</html>
