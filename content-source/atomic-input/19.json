    "coming_soon_zh 2": "min-width:0;margin:0;max-width:100%;text-align:center;font-family:var(--mpcbc-font-529ca1d09);font-size:28px;line-height:1.5em;color:var(--mpcbc-color-4a261092f);",
    "coming_soon_desc 3": "min-width:0;margin:0;max-width:100%;text-align:center;font-size:18px;line-height:1.6em;color:var(--mpcbc-color-4a261092f);",
    "coming_soon_btn 4": "min-width:0;margin:0;max-width:100%;padding:16px 28px 16px 28px;border-radius:12px 12px 12px 12px;font-size:17px;font-weight:600;color:var(--mpcbc-color-54922f2e9);background-color:var(--mpcbc-color-14b48ba19);display:inline-flex;justify-content:flex-start;align-items:center;align-self:flex-start;text-decoration:none;border-style:none;width:auto;font-family:var(--mpcbc-font-0071814e4);",
    "Boxed inner 5": "min-width:0;margin:0;display:flex;flex-direction:column;width:100%;padding:0;gap:24px;align-items:center;justify-content:center;max-width:900px;margin-left:auto;margin-right:auto;",
    "coming_soon_root 6": "min-width:0;margin:0;display:flex;flex-direction:column;width:100%;padding:120px 32px 120px 32px;gap:24px;min-height:60vh;align-items:center;justify-content:center;"
