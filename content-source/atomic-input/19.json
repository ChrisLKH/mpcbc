{
  "xml_structure": "<e-flexbox configuration-id=\"coming_soon_root 6\"><e-flexbox configuration-id=\"Boxed inner 5\"><e-heading configuration-id=\"coming_soon_title 1\"></e-heading><e-paragraph configuration-id=\"coming_soon_zh 2\"></e-paragraph><e-paragraph configuration-id=\"coming_soon_desc 3\"></e-paragraph><e-button configuration-id=\"coming_soon_btn 4\"></e-button></e-flexbox></e-flexbox>",
