","bottom":"1","left":"1","isLinked":false},"accordion_border_active_border":"solid","accordion_border_active_width":{"unit":"px","top":"1","right":"1","bottom":"1","left":"1","isLinked":false}},"elements":[{"id":"bc0003c","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"unit":"px","size":20},"padding":{"unit":"px","top":"4","right":"24","bottom":"24","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"4","right":"20","bottom":"24","left":"20","isLinked":false},"border_border":"none","border_radius":{"unit":"px","top":"0","right":"0","bottom":"12","left":"12","isLinked":false},"background_background":"classic","__globals__":{"background_color":"globals\/colors?id=white"}},"elements":[{"id":"bc00038","elType":"widget","settings":{"editor":"<p>God is the Creator and Ruler of the universe. He exists eternally as three persons: the Father, the Son and the Holy Spirit. These three are equal and are one God.<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"},{"id":"bc0003a","elType":"widget","settings":{"title":"Scripture references","header_size":"h3","__globals__":{"title_color":"globals\/colors?id=primary","typography_typography":"globals\/typography?id=about_en_label"}},"elements":[],"widgetType":"heading"},{"id":"bc0003b","elType":"widget","settings":{"editor":"<p>Genesis 1:1,26,27, 3:22, Psalms 90:2; Matthew 28:19; 1 Peter 1:2; 2 Corinthians 13:14<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"}],"isInner":false},{"id":"bc00041","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"unit":"px","size":20},"padding":{"unit":"px","top":"4","right":"24","bottom":"24","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"4","right":"20","bottom":"24","left":"20","isLinked":false},"border_border":"none","border_radius":{"unit":"px","top":"0","right":"0","bottom":"12","left":"12","isLinked":false},"background_background":"classic","__globals__":{"background_color":"globals\/colors?id=white"}},"elements":[{"id":"bc0003d","elType":"widget","settings":{"editor":"<p>Jesus Christ is the Son of God and is equal with the Father. Jesus lived a sinless life on earth and offered Himself as the perfect sacrifice, dying on the cross for all humanity. He rose from the dead after three days, demonstrating His power over sin and death. He ascended to heavenly glory and will return to earth as King of kings and Lord of lords.<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"},{"id":"bc0003f","elType":"widget","settings":{"title":"Scripture references","header_size":"h3","__globals__":{"title_color":"globals\/colors?id=primary","typography_typography":"globals\/typography?id=about_en_label"}},"elements":[],"widgetType":"heading"},{"id":"bc00040","elType":"widget","settings":{"editor":"<p>Matthew 1:22-23; Isaiah 9:6; John 1:1-5, 14:10-30; Hebrews 4:14,15; 1 Corinthians 15:3-4; Romans 1:3-4; Acts 1:9-11; 1 Timothy 6:14; Titus 2:13<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"}],"isInner":false},{"id":"bc00046","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"unit":"px","size":20},"padding":{"unit":"px","top":"4","right":"24","bottom":"24","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"4","right":"20","bottom":"24","left":"20","isLinked":false},"border_border":"none","border_radius":{"unit":"px","top":"0","right":"0","bottom":"12","left":"12","isLinked":false},"background_background":"classic","__globals__":{"background_color":"globals\/colors?id=white"}},"elements":[{"id":"bc00042","elType":"widget","settings":{"editor":"<p>The Holy Spirit is equal with the Father and the Son. He is present in the world to help people know Christ, and He lives in every Christian from the moment of salvation. He gives believers power for daily living, understanding of spiritual truth and guidance for the way ahead. He gives spiritual gifts to every believer. As Christians, we seek daily to live under the Holy Spirit\u2019s direction.<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"},{"id":"bc00044","elType":"widget","settings":{"title":"Scripture references","header_size":"h3","__globals__":{"title_color":"globals\/colors?id=primary","typography_typography":"globals\/typography?id=about_en_label"}},"elements":[],"widgetType":"heading"},{"id":"bc00045","elType":"widget","settings":{"editor":"<p>2 Corinthians 3:17; John 16:7-13, 14:16-17; Acts 1:8; 1 Corinthians 2:12; 3:16 Ephesians 1:13,5:18; Galatians 5:25<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"}],"isInner":false},{"id":"bc0004b","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"unit":"px","size":20},"padding":{"unit":"px","top":"4","right":"24","bottom":"24","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"4","right":"20","bottom":"24","left":"20","isLinked":false},"border_border":"none","border_radius":{"unit":"px","top":"0","right":"0","bottom":"12","left":"12","isLinked":false},"background_background":"classic","__globals__":{"background_color":"globals\/colors?id=white"}},"elements":[{"id":"bc00047","elType":"widget","settings":{"editor":"<p>The Bible is God\u2019s Word to us, written by people under the supernatural guidance of the Holy Spirit. It is the highest authority for Christian faith and life.<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"},{"id":"bc00049","elType":"widget","settings":{"title":"Scripture references","header_size":"h3","__globals__":{"title_color":"globals\/colors?id=primary","typography_typography":"globals\/typography?id=about_en_label"}},"elements":[],"widgetType":"heading"},{"id":"bc0004a","elType":"widget","settings":{"editor":"<p>2 Timothy 3:16,1:13; 2 Peter 1:20-21; Psalms 119:105, 160, 12:6; Proverbs 30:5<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"}],"isInner":false},{"id":"bc00050","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"unit":"px","size":20},"padding":{"unit":"px","top":"4","right":"24","bottom":"24","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"4","right":"20","bottom":"24","left":"20","isLinked":false},"border_border":"none","border_radius":{"unit":"px","top":"0","right":"0","bottom":"12","left":"12","isLinked":false},"background_background":"classic","__globals__":{"background_color":"globals\/colors?id=white"}},"elements":[{"id":"bc0004c","elType":"widget","settings":{"editor":"<p>Human beings were created in God\u2019s spiritual image, reflecting His character. Humanity is the pinnacle of God\u2019s creation. Although every person has the potential for good, our sinful attitudes separate us from God and bring many problems into our lives.<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"},{"id":"bc0004e","elType":"widget","settings":{"title":"Scripture references","header_size":"h3","__globals__":{"title_color":"globals\/colors?id=primary","typography_typography":"globals\/typography?id=about_en_label"}},"elements":[],"widgetType":"heading"},{"id":"bc0004f","elType":"widget","settings":{"editor":"<p>Genesis 1:27; Psalms 8:3-6; Isaiah 53:6a; Romans 3:23; Isaiah 59:1-2<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"}],"isInner":false},{"id":"bc00055","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"unit":"px","size":20},"padding":{"unit":"px","top":"4","right":"24","bottom":"24","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"4","right":"20","bottom":"24","left":"20","isLinked":false},"border_border":"none","border_radius":{"unit":"px","top":"0","right":"0","bottom":"12","left":"12","isLinked":false},"background_background":"classic","__globals__":{"background_color":"globals\/colors?id=white"}},"elements":[{"id":"bc00051","elType":"widget","settings":{"editor":"<p>Salvation is God\u2019s free gift, which we must receive. We can never atone for our sins through good works or self-improvement. Only through Jesus Christ and God\u2019s forgiveness can we be delivered from the penalty of sin. We are saved when we turn in faith to Jesus from a self-centred life lived in our own strength. Eternal life begins when we receive the life of Jesus Christ by faith.<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"},{"id":"bc00053","elType":"widget","settings":{"title":"Scripture references","header_size":"h3","__globals__":{"title_color":"globals\/colors?id=primary","typography_typography":"globals\/typography?id=about_en_label"}},"elements":[],"widgetType":"heading"},{"id":"bc00054","elType":"widget","settings":{"editor":"<p>Romans 6:23,5:1; Ephesians 2:8-9; John 14:6;1:12; Titus 3:5; Galatians 3:26<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"}],"isInner":false},{"id":"bc0005a","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"unit":"px","size":20},"padding":{"unit":"px","top":"4","right":"24","bottom":"24","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"4","right":"20","bottom":"24","left":"20","isLinked":false},"border_border":"none","border_radius":{"unit":"px","top":"0","right":"0","bottom":"12","left":"12","isLinked":false},"background_background":"classic","__globals__":{"background_color":"globals\/colors?id=white"}},"elements":[{"id":"bc00056","elType":"widget","settings":{"editor":"<p>Because God gives us eternal life through Jesus Christ, true believers have eternal assurance of salvation. Salvation comes through God\u2019s power and grace, not through a Christian\u2019s own efforts. His preserving power and grace give us this lasting assurance. Believers also have a responsibility to continue trusting God and living in His care.<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"},{"id":"bc00058","elType":"widget","settings":{"title":"Scripture references","header_size":"h3","__globals__":{"title_color":"globals\/colors?id=primary","typography_typography":"globals\/typography?id=about_en_label"}},"elements":[],"widgetType":"heading"},{"id":"bc00059","elType":"widget","settings":{"editor":"<p>John 10:29; 2 Timothy 1:12; Hebrews 7:25, 10:10,14; 1 Peter 1:3-5; Hebrews 6:4-8; Hebrews 10:26-27; John 15:6<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=about_en_body"}},"elements":[],"widgetType":"text-editor"}],"isInner":false},{"id":"bc0005f","elType":"container","settings":{"content_width":"full","flex_direction":"colu