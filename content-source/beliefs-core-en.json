        {
          "id": "bc00038",
          "elType": "widget",
          "settings": {
            "editor": "<p>God is the Creator and Ruler of the universe. He exists eternally as three persons: the Father, the Son and the Holy Spirit. These three are equal and are one God.</p>",
            "__globals__": {
              "text_color": "globals/colors?id=text",
              "typography_typography": "globals/typography?id=interior_body"
            }
          },
          "elements": [],
          "widgetType": "text-editor"
        },
        {
          "id": "bc0003a",
          "elType": "widget",
          "settings": {
            "title": "Scripture references",
            "header_size": "h3",
            "__globals__": {
              "title_color": "globals/colors?id=primary",
              "typography_typography": "globals/typography?id=interior_refs"
            }
          },
          "elements": [],
          "widgetType": "heading"
        },
        {
          "id": "bc0003b",
          "elType": "widget",
          "settings": {
            "editor": "<p>Genesis 1:1,26,27, 3:22, Psalms 90:2; Matthew 28:19; 1 Peter 1:2; 2 Corinthians 13:14</p>",
            "__globals__": {
              "text_color": "globals/colors?id=text",
              "typography_typography": "globals/typography?id=interior_zh"
            }
          },
          "elements": [],
