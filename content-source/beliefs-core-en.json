    },
    {
      "id": "bc0004b",
      "elType": "container",
      "settings": {
        "content_width": "full",
        "flex_direction": "column",
        "flex_gap": {
          "unit": "px",
          "size": 20
        }
      },
      "elements": [
        {
          "id": "bc00047",
          "elType": "widget",
          "settings": {
            "editor": "<p>The Bible is God’s Word to us, written by people under the supernatural guidance of the Holy Spirit. It is the highest authority for Christian faith and life.</p>",
            "__globals__": {
              "text_color": "globals/colors?id=text",
              "typography_typography": "globals/typography?id=interior_body"
            }
          },
          "elements": [],
          "widgetType": "text-editor"
        },
        {
          "id": "bc00049",
          "elType": "widget",
          "settings": {
            "title": "Scripture references",
            "header_size": "h3",
            "__globals__": {
              "title_color": "globals/colors?id=primary",
              "typography_typography": "globals/typography?id=interior_refs"
            }
          },
          "elements": [],
          "widgetType": "heading"
        },
        {
          "id": "bc0004a",
          "elType": "widget",
          "settings": {
            "editor": "<p>2 Timothy 3:16,1:13; 2 Peter 1:20-21; Psalms 119:105, 160, 12:6; Proverbs 30:5</p>",
            "__globals__": {
              "text_color": "globals/colors?id=text",
              "typography_typography": "globals/typography?id=interior_zh"
            }
          },
          "elements": [],
          "widgetType": "text-editor"
        }
      ],
