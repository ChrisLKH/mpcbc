                    "settings": {
                        "container_class": "field-wrap"
                    },
                    "columns": [
                        {
                            "width": 50,
                            "fields": [
                                {
                                    "element": "input_text",
                                    "attributes": {
                                        "name": "names",
                                        "id": "pr-name",
                                        "type": "text",
                                        "placeholder": "Your name",
                                        "class": ""
                                    },
                                    "settings": {
                                        "container_class": "field-wrap",
                                        "label": "Name (optional)",
                                        "label_placement": "top"
                                    },
                                    "editor_options": {
                                        "title": "Name"
                                    }
                                }
                            ]
                        },
                        {
                            "width": 50,
                            "fields": [
                                {
                                    "element": "input_text",
                                    "attributes": {
                                        "name": "email_or_phone",
                                        "id": "pr-contact",
                                        "type": "text",
                                        "placeholder": "you@example.com or phone",
                                        "class": ""
                                    },
                                    "settings": {
                                        "container_class": "field-wrap",
                                        "label": "Email or phone (optional)",
                                        "label_placement": "top"
                                    },
                                    "editor_options": {
                                        "title": "Contact info"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "element": "input_radio",
                    "attributes": {
                        "name": "who_may_see",
                        "id": "pr-who",
                        "type": "radio",
                        "value": "pastors",
                        "class": ""
                    },
                    "settings": {
                        "container_class": "field-wrap",
                        "label": "Who may see this?",
                        "label_placement": "top",
                        "advanced_options": [
                            {
                                "label": "Pastors only",
                                "value": "pastors"
                            },
                            {
                                "label": "Pastors and the prayer team",
                                "value": "team"
