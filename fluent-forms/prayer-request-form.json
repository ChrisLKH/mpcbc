                        ]
                    },
                    "options": {
                        "pastors": "Pastors only",
                        "team": "Pastors and the prayer team"
                    },
                    "editor_options": {
                        "title": "Radio Field"
                    }
                },
                {
                    "element": "input_checkbox",
                    "attributes": {
                        "name": "contact_me",
                        "id": "pr-contact-me",
                        "type": "checkbox",
                        "class": ""
