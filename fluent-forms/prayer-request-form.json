                    "settings": {
                        "container_class": "field-wrap",
                        "label": "",
                        "advanced_options": [
                            {
                                "label": "I’d like someone to contact me",
                                "value": "yes"
                            }
                        ]
                    },
                    "options": {
                        "yes": "I’d like someone to contact me"
                    },
                    "editor_options": {
                        "title": "Checkbox Field"
                    }
                }
